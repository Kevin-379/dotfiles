{
  "npmCommand": [
    "npm",
    "--prefix",
    "~/.local",
    "--registry=https://registry.npmjs.org"
  ],
  "lastChangelogVersion": "0.80.1",
  "defaultProvider": "openai",
  "defaultModel": "gpt-5.5",
  "steeringMode": "all",
  "followUpMode": "one-at-a-time",
  "quietStartup": true,
  "packages": [
    "npm:pi-token-speed",
    "npm:pi-mcp-adapter",
    "npm:vim-motions-pi",
    "npm:@plannotator/pi-extension",
    "~/Personal/pi-powerline-footer",
    "npm:pi-context",
    "npm:pi-hermes-memory",
    "npm:pi-taskflow",
    "npm:pi-until-done"
  ],
  "powerline": {
    "preset": "custom",
    "fixedEditor": true,
    "mouseScroll": true
  },
  "powerlineShortcuts": {
    "jumpChatBottom": "ctrl+alt+g"
  },
  "startupModel": {
    "model": "openai/gpt-5.5",
    "thinkingLevel": "medium"
  },
  "defaultThinkingLevel": "medium",
  "enableSkillCommands": true,
  "modelRoles": {
    "fast": "openai/gpt-5.5:low",
    "strong": "openai/gpt-5.5:medium",
    "thinker": "openai/gpt-5.5:high",
    "arbiter": "openai/gpt-5.5:xhigh",
    "vision": "openai/gpt-5.5:medium",
    "reasoner": "openai/gpt-5.5:high"
  },
  "theme": "dark"
}