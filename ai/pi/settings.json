{
  "npmCommand": [
    "npm",
    "--registry=https://registry.npmjs.org"
  ],
  "lastChangelogVersion": "0.84.3",
  "defaultProvider": "openai",
  "defaultModel": "gpt-5.6-sol",
  "steeringMode": "all",
  "followUpMode": "one-at-a-time",
  "quietStartup": true,
  "packages": [
    "npm:pi-token-speed",
    "npm:vim-motions-pi",
    "npm:@plannotator/pi-extension",
    "~/Personal/pi-powerline-footer",
    "npm:pi-context",
    "npm:pi-hermes-memory",
    "npm:pi-taskflow",
    "git:github.com/Helmi/pi-event-monitor"
  ],
  "powerline": {
    "preset": "custom",
    "fixedEditor": true,
    "mouseScroll": true,
    "placement": "below"
  },
  "powerlineShortcuts": {
    "jumpChatBottom": "ctrl+alt+g"
  },
  "startupModel": {
    "model": "openai/gpt-5.6-sol",
    "thinkingLevel": "medium"
  },
  "defaultThinkingLevel": "medium",
  "enableSkillCommands": true,
  "modelRoles": {
    "fast": "openai/gpt-5.6-terra",
    "strong": "openai/gpt-5.6-terra",
    "thinker": "openai/gpt-5.6-sol",
    "arbiter": "openai/gpt-5.6-sol",
    "vision": "openai/gpt-5.6-terra",
    "reasoner": "openai/gpt-5.6-sol"
  },
  "theme": "dark",
  "enableInstallTelemetry": false,
  "taskflow": {
    "piChild": {
      "resourceProfile": "inherit"
    }
  },
  "branchSummaryExtension": {
    "interval": 5
  },
  "showLastPrompt": false,
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "resume-hint"
}