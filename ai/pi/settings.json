{
  "npmCommand": [
    "npm",
    "--registry=https://registry.npmjs.org"
  ],
  "lastChangelogVersion": "0.99.1",
  "defaultProvider": "openai",
  "defaultModel": "gpt-5.6-sol",
  "steeringMode": "all",
  "followUpMode": "one-at-a-time",
  "quietStartup": true,
  "packages": [
    "npm:pi-token-speed",
    "npm:vim-motions-pi",
    "npm:@plannotator/pi-extension",
    "~/Personal/pi-powerline-footer",
    "npm:pi-context",
    "npm:pi-hermes-memory",
    "npm:pi-taskflow",
    "git:github.com/Helmi/pi-event-monitor",
    "npm:pi-custom-compaction"
  ],
  "powerline": {
    "preset": "custom",
    "fixedEditor": true,
    "mouseScroll": true,
    "placement": "below"
  },
  "powerlineShortcuts": {
    "jumpChatBottom": "ctrl+alt+g"
  },
  "startupModel": {
    "model": "openai/gpt-6.1-sol",
    "thinkingLevel": "medium"
  },
  "defaultThinkingLevel": "medium",
  "enableSkillCommands": true,
  "modelRoles": {
    "builder": "openai/gpt-6.1-sol",
    "scout": "openai/gpt-6.1-sol",
    "expert": "anthropic/claude-opus-5-5",
    "steward": "anthropic/claude-opus-5-5"
  },
  "theme": "dark",
  "enableInstallTelemetry": false,
  "taskflow": {
    "piChild": {
      "resourceProfile": "inherit"
    }
  },
  "branchSummaryExtension": {
    "interval": 5
  },
  "showLastPrompt": false,
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "resume-hint"
}