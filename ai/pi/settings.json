{
  "npmCommand": [
    "npm",
    "--registry=https://registry.npmjs.org"
  ],
  "lastChangelogVersion": "1.4.0",
  "defaultProvider": "openai",
  "defaultModel": "sol",
  "steeringMode": "all",
  "followUpMode": "one-at-a-time",
  "quietStartup": true,
  "packages": [
    "npm:pi-token-speed",
    "npm:vim-motions-pi",
    "npm:@plannotator/pi-extension",
    "~/Personal/pi-powerline-footer",
    "npm:pi-context",
    "npm:pi-hermes-memory",
    "npm:pi-taskflow",
    "git:github.com/Helmi/pi-event-monitor",
    "npm:pi-custom-compaction"
  ],
  "powerline": {
    "preset": "custom",
    "fixedEditor": true,
    "mouseScroll": true,
    "placement": "below"
  },
  "powerlineShortcuts": {
    "jumpChatBottom": "ctrl+alt+g"
  },
  "startupModel": {
    "model": "openai/sol",
    "thinkingLevel": "medium"
  },
  "defaultThinkingLevel": "medium",
  "enableSkillCommands": true,
  "modelRoles": {
    "builder": "router/coding",
    "scout": "openai/sol",
    "expert": "anthropic/opus",
    "steward": "anthropic/opus"
  },
  "theme": "system",
  "enableInstallTelemetry": false,
  "taskflow": {
    "piChild": {
      "resourceProfile": "inherit"
    }
  },
  "branchSummaryExtension": {
    "interval": 5
  },
  "showLastPrompt": false,
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "resume-hint"
}